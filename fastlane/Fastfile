default_platform(:ios)

desc "Write Fastlane metadata from store/listing.yml"
lane :expand_listing do
  sh("ruby", File.expand_path("../tools/store/expand_listing.rb", __dir__))
end

platform :ios do
  desc "Load App Store Connect API key from gitignored secrets/"
  private_lane :asc_api_key do
    root = File.expand_path("..", __dir__)
    app_store_connect_api_key(
      key_id: File.read(File.join(root, "secrets/apple/key_id")).strip,
      issuer_id: File.read(File.join(root, "secrets/apple/issuer_id")).strip,
      key_filepath: File.join(root, "secrets/apple/AuthKey_K2MYWPZA23.p8"),
      in_house: false
    )
  end

  desc "Upload App Store listing only (no IPA)"
  lane :upload_asc_listing do
    expand_listing
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :android do
  desc "Upload Play Store listing only (no AAB/APK)"
  lane :upload_play_listing do
    expand_listing
    # Stock `supply --skip_upload_apk --skip_upload_aab --skip_upload_images
    # --skip_upload_screenshots` still requires a production release on Fastlane
    # 2.238.0. A listing edit does not.
    require "supply"

    root = File.expand_path("..", __dir__)
    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
      json_key: File.join(root, "secrets/google/play-store.json"),
      package_name: "pro.daddoodev.dailycompany",
      metadata_path: File.join(root, "fastlane/metadata/android")
    })

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: "pro.daddoodev.dailycompany")

    lang = "en-US"
    dir = File.join(root, "fastlane/metadata/android", lang)
    client.update_listing_for_language(
      language: lang,
      title: File.read(File.join(dir, "title.txt")).strip,
      short_description: File.read(File.join(dir, "short_description.txt")).strip,
      full_description: File.read(File.join(dir, "full_description.txt")).strip
    )
    images = File.join(dir, "images")
    {
      "featureGraphic" => "featureGraphic.png",
      "icon" => "icon.png"
    }.each do |image_type, filename|
      path = File.join(images, filename)
      next unless File.exist?(path)
      client.upload_image(image_path: path, image_type: image_type, language: lang)
    end
    client.commit_current_edit!
    UI.success("Play listing uploaded for #{lang}")
  end
end
