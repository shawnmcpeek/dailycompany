# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.env
.env.*
!.env.example

# Content pipeline raw downloads (large / regenerable)
tools/content/raw/
tools/content/work/
__pycache__/
*.mp3

# Generated review artifacts are fine to commit for human QA
# tools/content/review/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
*.aab
*.apk
*.ap_

# Android release signing (never commit)
/android/key.properties
*.jks
*.keystore
**/upload-keystore.*

# Apple App Store Connect keys (never commit)
*.p8
SubscriptionKey_*.p8
AuthKey_*.p8

# Local store / IAP credentials (never commit)
/secrets/

# Sentry native crashpad / runtime state (never commit)
.sentry-native/
